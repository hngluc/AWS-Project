{
  "name": "smart-image-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Image Storage & Processing Platform - Serverless on AWS",
  "workspaces": [
    "infrastructure",
    "backend/shared",
    "backend/api-handler",
    "backend/image-processor",
    "backend/ai-analyzer",
    "backend/authorizer",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "cdk": "npm run --workspace=infrastructure cdk",
    "deploy": "npm run --workspace=infrastructure deploy",
    "synth": "npm run --workspace=infrastructure synth"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.9.9"
  }
}
